# Production-only, used by the "caddy" compose service (--profile production)
# to get an automatic Let's Encrypt HTTPS cert. Requires a real domain's DNS
# pointed at the server's IP -- App Store builds refuse plain HTTP APIs (ATS).
API_DOMAIN=api.example.com
CADDY_EMAIL=you@example.com

DATABASE_URL=postgresql://user:password@localhost:5432/findyourbuddy
# Connection pool + timeouts. DB_STATEMENT_TIMEOUT_MS is the important one:
# it caps how long one query can pin a request-handler thread, so a slow DB
# moment can't cascade into an unrecoverable freeze.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_S=10
DB_POOL_RECYCLE_S=1800
DB_CONNECT_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT_MS=8000
DB_LOCK_TIMEOUT_MS=4000

# Optional -- swipe-candidate caching falls back to Postgres-only if unset
# or unreachable. Use redis://redis:6379/0 when running via docker-compose.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
# Access token lifetime. 43200 = 30 days; refresh token below extends sessions further.
JWT_EXPIRE_MINUTES=43200
JWT_REFRESH_EXPIRE_DAYS=30

DAILY_SWIPE_LIMIT=50
DAILY_SUPER_LIKE_LIMIT=1
PREMIUM_DAILY_SUPER_LIKE_LIMIT=5
WEEKLY_EVENT_CREATION_LIMIT=3
MATCH_COMMON_INTEREST_WEIGHT=0.6
MATCH_DISTANCE_WEIGHT=0.4
MATCH_MAX_DISTANCE_KM=50.0

# Accounts auto-suspend once trust_score stays below the threshold for the
# grace period (consecutive days), not on a single low reading.
TRUST_SCORE_SUSPENSION_THRESHOLD=-5
TRUST_SCORE_SUSPENSION_GRACE_DAYS=14

RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_EVENT_WRITES_PER_MINUTE=20
# Selfie verification (Vision) and LLM zodiac-synergy matching -- each call
# is a real, billed OpenAI request, so this stays tight.
RATE_LIMIT_AI_PER_MINUTE=5

MODERATION_BANNED_WORDS=spam,scam

SCRAPER_API_KEY=change-me

# Lets Prometheus scrape GET /health/metrics without a staff JWT. Send it as the
# X-Metrics-Api-Key header (or a bearer token). Empty -> endpoint stays staff-only.
METRICS_API_KEY=

# Firebase Admin SDK service account JSON (single-line, no newlines).
# Required for backend-side Firestore message relay (real-time chat delivery).
# Generate from Firebase Console → Project Settings → Service Accounts.
# Without this, messages are stored in Postgres but not relayed to Firestore,
# so the chat screen won't receive real-time updates.
FIREBASE_SERVICE_ACCOUNT_JSON=
ALLOWED_EVENT_CATEGORIES=running,coffee,concert,festival,climbing,hiking,cycling,yoga,boardgames,football,party,theatre,art,workshop,hobby,other

MEDIA_ROOT=media
MEDIA_BASE_URL=/media
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Media storage: "local" (disk-backed, fine for one server and local dev) or
# "s3" (AWS S3 or an S3-compatible provider like Cloudflare R2). For "s3" every
# S3_* value below is required -- leaving S3_ENDPOINT_URL empty targets real AWS
# S3, set it to https://<account_id>.r2.cloudflarestorage.com for R2.
MEDIA_STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
# Comma-separated list of allowed browser origins. "*" is fine for local dev but
# ENVIRONMENT=production rejects it -- list your real app/web origins there.
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO

# Empty -> in-process rate-limit counters (correct only for a single worker).
# Set to the Redis URL when running multiple workers / hosts so limits are shared.
RATE_LIMIT_STORAGE_URI=

SENTRY_DSN=
ENVIRONMENT=development

EVENT_RETENTION_DAYS=30
SCHEDULER_INTERVAL_HOURS=6.0
# Runs the periodic cleanup jobs. With multiple web workers set this to false
# here and run ONE dedicated process with SCHEDULER_ENABLED=true. An advisory
# lock guards against overlap either way.
SCHEDULER_ENABLED=true

# Gunicorn worker count in the container (default: 2*CPU + 1).
WEB_CONCURRENCY=

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Bare host only, no scheme -- http.client.HTTPSConnection rejects a URL here.
IYZICO_BASE_URL=sandbox-api.iyzipay.com
# Production iyzico requires a real TC identity number for the buyer.
# Replace with actual buyer identity number before going live.
IYZICO_BUYER_IDENTITY_NUMBER=11111111111
# Monthly subscription price in TRY. Must match the price shown in the app UI.
SUBSCRIPTION_PRICE_TRY=99.00

# Password reset emails (SMTP). All fields required for email delivery.
# If left empty, the app falls back to logging password reset tokens instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@findyourbuddy.app
# Where unhandled 500 alerts are emailed. Empty disables the alert email.
ADMIN_ALERT_EMAIL=

# ENVIRONMENT=production requires SMTP_HOST + SMTP_USERNAME + SMTP_PASSWORD to
# all be set -- otherwise "forgot password" silently only logs the code.

# Nominatim's usage policy rejects placeholder/example.com-style User-Agents
# with a 403 -- use a real contact email here.
GEOCODING_USER_AGENT=findyourbuddy-app/0.1 (kendi_epostaniz@gmail.com)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

NOVITA_API_KEY=BURAYA_NOVITA_API_KEY_GELECEK
NOVITA_BASE_URL=https://api.novita.ai/openai
NOVITA_MODEL=deepseek/deepseek-v4-flash
NOVITA_VISION_MODEL=qwen/qwen3.6-27b

# Push notifications: "logging" (dev, logs to stdout) or "expo" (production).
PUSH_PROVIDER=expo
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# TURN server for WebRTC NAT traversal (required for calls on real mobile networks).
# Comma-separated list of TURN URLs, e.g. turn:your-server.com:3478,turns:your-server.com:5349
# Self-host with Coturn or use a managed service (Twilio, Metered.ca, etc.)
TURN_URLS=
# Static credential pair (simplest). Prefer the HMAC secret below for a public
# TURN server so credentials expire.
TURN_USERNAME=
TURN_CREDENTIAL=
# coturn "use-auth-secret" (static-auth-secret in turnserver.conf). When set,
# /calls/ice-servers returns a per-request credential valid for TTL seconds.
TURN_STATIC_AUTH_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=86400