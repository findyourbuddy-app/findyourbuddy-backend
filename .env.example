# Production-only, used by the "caddy" compose service (--profile production)
# to get an automatic Let's Encrypt HTTPS cert. Requires a real domain's DNS
# pointed at the server's IP -- App Store builds refuse plain HTTP APIs (ATS).
API_DOMAIN=api.example.com
CADDY_EMAIL=you@example.com

DATABASE_URL=postgresql://user:password@localhost:5432/findyourbuddy
# Optional -- swipe-candidate caching falls back to Postgres-only if unset
# or unreachable. Use redis://redis:6379/0 when running via docker-compose.
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DAILY_SWIPE_LIMIT=50
MATCH_COMMON_INTEREST_WEIGHT=0.6
MATCH_DISTANCE_WEIGHT=0.4
MATCH_MAX_DISTANCE_KM=50.0

RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_EVENT_WRITES_PER_MINUTE=20
# Selfie verification (Vision) and LLM zodiac-synergy matching -- each call
# is a real, billed OpenAI request, so this stays tight.
RATE_LIMIT_AI_PER_MINUTE=5

MODERATION_BANNED_WORDS=spam,scam

SCRAPER_API_KEY=change-me
ALLOWED_EVENT_CATEGORIES=running,coffee,concert,climbing,hiking,cycling,yoga,boardgames,football,party,theatre,art,workshop,hobby,other

MEDIA_ROOT=media
MEDIA_BASE_URL=/media
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Media storage: "local" (default, disk-backed, fine for one server) or
# "s3" (AWS S3 or an S3-compatible provider like Cloudflare R2). Leaving
# S3_ENDPOINT_URL empty targets real AWS S3; set it to
# https://<account_id>.r2.cloudflarestorage.com for R2.
MEDIA_STORAGE_BACKEND=s3
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO

SENTRY_DSN=
ENVIRONMENT=development

EVENT_RETENTION_DAYS=30
SCHEDULER_INTERVAL_HOURS=6.0

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Bare host only, no scheme -- http.client.HTTPSConnection rejects a URL here.
IYZICO_BASE_URL=sandbox-api.iyzipay.com
# Production iyzico requires a real TC identity number for the buyer.
# Replace with actual buyer identity number before going live.
IYZICO_BUYER_IDENTITY_NUMBER=11111111111
# Monthly subscription price in TRY. Must match the price shown in the app UI.
SUBSCRIPTION_PRICE_TRY=99.00

# Password reset emails (SMTP). All fields required for email delivery.
# If left empty, the app falls back to logging password reset tokens instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@findyourbuddy.app

# Nominatim's usage policy rejects placeholder/example.com-style User-Agents
# with a 403 -- use a real contact email here.
GEOCODING_USER_AGENT=findyourbuddy-app/0.1 (kendi_epostaniz@gmail.com)

NOVITA_API_KEY=BURAYA_NOVITA_API_KEY_GELECEK
NOVITA_BASE_URL=https://api.novita.ai/openai
NOVITA_MODEL=deepseek/deepseek-v4-flash
NOVITA_VISION_MODEL=qwen/qwen3.6-27b

# Push notifications: "logging" (dev, logs to stdout) or "expo" (production).
PUSH_PROVIDER=expo

# TURN server for WebRTC NAT traversal (required for calls on real mobile networks).
# Comma-separated list of TURN URLs, e.g. turn:your-server.com:3478,turns:your-server.com:5349
# Self-host with Coturn or use a managed service (Twilio, Metered.ca, etc.)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=